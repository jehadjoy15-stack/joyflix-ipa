{
  "expo": {
    "name": "JoyFlix",
    "slug": "joyflix-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/joyflix_logo.png",
    "scheme": "joyflixapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/joyflix_logo.png"
    },
    "android": {
      "package": "com.joyflix.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090b",
        "foregroundImage": "./assets/images/joyflix_logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#09090b",
          "image": "./assets/images/joyflix_logo.png",
          "imageWidth": 150
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
